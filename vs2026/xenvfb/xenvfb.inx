; SPDX-License-Identifier: BSD-2-Clause

[Version]
Signature = "$WINDOWS NT$"
Class = Display
ClassGUID = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider = %ManufacturerName%
CatalogFile = xenvfb.cat
DriverVer = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
xenvfb.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%xenvfb.DeviceDesc% = xenvfb_Device, Root\xenvfb ; TODO: edit hw-id

[xenvfb_Device.NT]
CopyFiles = File_Copy

[File_Copy]
xenvfb.sys

;-------------- Service installation
[xenvfb_Device.NT.Services]
AddService = xenvfb,%SPSVCINST_ASSOCSERVICE%, xenvfb_Service_Inst

; -------------- xenvfb driver install sections
[xenvfb_Service_Inst]
DisplayName = %xenvfb.SVCDESC%
ServiceType = 1 ; SERVICE_KERNEL_DRIVER
StartType = 3 ; SERVICE_DEMAND_START
ErrorControl = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\xenvfb.sys

[xenvfb_Device.NT.Wdf]
KmdfService = xenvfb, xenvfb_wdfsect

[xenvfb_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ; TODO: Replace with your manufacturer name
DiskName = "xenvfb Installation Disk"
xenvfb.DeviceDesc = "xenvfb Device"
xenvfb.SVCDESC = "xenvfb Service"
